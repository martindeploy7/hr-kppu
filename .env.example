DATABASE_URL=postgres://kppu:kppu-local@127.0.0.1:5544/kppu
APP_ORIGIN=http://127.0.0.1:5173
PORT=8788
NODE_ENV=development
# Optional first Superadmin, provisioned only when no user exists.
# Set a unique password of at least 14 characters before first startup.
INITIAL_ADMIN_EMAIL=admin@kppu.test
INITIAL_ADMIN_NAME=Superadmin SDM
INITIAL_ADMIN_PASSWORD=
# On an existing database, set this to an existing active account's email only when no Superadmin exists.
# That account is promoted once at startup and its old sessions are revoked.
SUPERADMIN_EMAIL=
# Generate a private key with: openssl rand -base64 32. Keep it unchanged after WhatsApp is linked.
WHATSAPP_SESSION_ENCRYPTION_KEY=
