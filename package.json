{
  "name": "kppu-hr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && tsup",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p server/tsconfig.json",
    "start": "node dist-server/index.js",
    "db:migrate": "tsx --env-file=.env server/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:local": "node scripts/local-db.mjs",
    "user:create": "tsx --env-file=.env server/create-user.ts",
    "test": "vitest run",
    "preview": "vite preview",
    "test:e2e": "e2e run",
    "audit:parsers": "tsx scripts/parser-audit.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@node-rs/argon2": "2.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "framer-motion": "14.3.0",
    "hono": "4.13.13",
    "lucide-react": "1.59.0",
    "postgres": "3.4.9",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.12.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "e2e": "0.17.0",
    "embedded-postgres": "18.4.0-beta.17",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
